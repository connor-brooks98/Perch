# Copy to .env and fill in. Never commit the real .env.
# NOTE: values here are literal — do NOT quote, and $ is safe (env_file, no interpolation).

# ---- Blink (dedicated feeder account, NOT her personal login) ----
BLINK_USERNAME=feeder-account@example.com
BLINK_PASSWORD=change-me
# Exact camera name as shown by auth_setup.py. Use "all" to pull every camera.
CAMERA_NAME=all

# ---- Pipeline tuning ----
# seconds between Blink checks (puller)
POLL_INTERVAL=300
# seconds between classifier passes
WATCH_INTERVAL=20
# frames sampled per clip for ID
FRAMES_PER_CLIP=4
# below this, a clip is logged as "no confident ID"
CONFIDENCE_THRESHOLD=0.30
# delete raw clip files older than this (0 = keep forever)
RETAIN_DAYS=14
THUMB_WIDTH=480

# ---- Paths (defaults match the compose volume layout; usually leave as-is) ----
DB_PATH=/data/db/feeder.sqlite
CLIPS_DIR=/data/clips
WEB_DIR=/data/web
BLINK_CREDS=/data/blink/creds.json
MODEL_PATH=/app/model/model.tflite
LABELS_PATH=/app/model/labels.txt

# ---- Dashboard login (Caddy basic_auth) ----
# Caddy re-verifies this hash with bcrypt on EVERY request — and a dashboard load
# fetches one thumbnail per card, so cost adds up fast on a Pi. `caddy
# hash-password` emits cost 14; if the web container is CPU-bound on load,
# regenerate at a lower cost (10-12) with htpasswd and use the part after ':' —
#   htpasswd -nbBC 10 birdwatcher 'your-password'
# Default (cost 14):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER=birdwatcher
BASIC_AUTH_HASH=REPLACE_WITH_CADDY_BCRYPT_HASH

# ---- Monitoring (optional). Unset = no pings. ----
NTFY_URL=
# e.g. https://ntfy.sh/connor-birdfeeder-pick-something-random

# ---- Cloudflare Tunnel (only if using docker-compose.cloudflare.yml) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Misc ----
TZ=America/New_York
LOG_LEVEL=INFO
