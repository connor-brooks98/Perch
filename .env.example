# Copy to .env, fill it in, then run: chmod 600 .env
# Never commit the real .env. Single quotes preserve literal $ characters.

# ---- Blink (dedicated feeder account, not an everyday personal login) ----
BLINK_USERNAME=feeder-account@example.com
BLINK_PASSWORD=change-me
# Exact camera name as shown by auth_setup.py. Use "all" to pull every camera.
CAMERA_NAME=all

# ---- Pipeline tuning ----
# seconds between Blink checks (puller)
POLL_INTERVAL=300
# seconds between classifier passes
WATCH_INTERVAL=20
# frames sampled per clip for ID
FRAMES_PER_CLIP=4
# below this, a clip is logged as "no confident ID"
CONFIDENCE_THRESHOLD=0.30
# delete raw clip files older than this (0 = keep forever)
RETAIN_DAYS=14
THUMB_WIDTH=480
# failed clips retry after 60s, then 120s; the third failure becomes terminal
MAX_CLIP_ATTEMPTS=3
CLIP_RETRY_DELAY=60
# healthy idle cycles between heartbeat notifications
HEARTBEAT_EVERY=12

# ---- Dashboard login (Caddy basic_auth) ----
# Caddy re-verifies this hash with bcrypt on EVERY request — and a dashboard load
# fetches one thumbnail per card, so cost adds up fast on a Pi. `caddy
# hash-password` emits cost 14; if the web container is CPU-bound on load,
# regenerate at a lower cost (10-12) with htpasswd and use the part after ':' —
#   htpasswd -nbBC 10 birdwatcher 'your-password'
# Default (cost 14):
#   docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext 'your-password'
# Paste the full output between single quotes. Do not double the $ characters.
# Example: BASIC_AUTH_HASH='$2a$14$the-rest-of-the-generated-hash'
BASIC_AUTH_USER=birdwatcher
BASIC_AUTH_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'

# ---- Monitoring (optional). Unset = no pings. ----
NTFY_URL=
# e.g. https://ntfy.sh/perch-pick-a-long-random-topic-name

# ---- Cloudflare Tunnel (only if using docker-compose.cloudflare.yml) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Misc ----
TZ=America/New_York
LOG_LEVEL=INFO
# Numeric owner of ./data on Linux (the first Raspberry Pi user is normally 1000)
PUID=1000
PGID=1000
